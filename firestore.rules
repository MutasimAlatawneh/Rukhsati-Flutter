rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read test centers and exam types
    match /test_centers/{center} {
      allow read: if true;
      allow write: if false;
    }
    
    match /exam_types/{type} {
      allow read: if true;
      allow write: if false;
    }
    
    // User profiles can only be read/written by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Bookings can be created and read by authenticated users
    match /bookings/{booking} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'center_admin'
      );
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 